FROM golang:1.24-alpine AS base
WORKDIR /app
RUN apk add --no-cache git

FROM base AS development
EXPOSE 8080
CMD ["sh", "-c", "go mod tidy && go run cmd/api/main.go"]

FROM base AS builder
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ .
# Optimized build flags for smaller binary and better performance
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -a -installsuffix cgo -o main ./cmd/api

FROM alpine:latest AS production
RUN apk --no-cache add ca-certificates tzdata wget
WORKDIR /app
COPY --from=builder /app/main .
# Set Go garbage collection for low memory environments
ENV GOGC=50
ENV GOMAXPROCS=1
EXPOSE 8080
CMD ["./main"]
