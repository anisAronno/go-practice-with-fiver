# Application
APP_NAME=GoFiver
APP_ENV=development
APP_DEBUG=true
APP_PORT=8080

# Database (Using common-docker MySQL)
DB_HOST=common-mysql
DB_PORT=3306
DB_DATABASE=gofiver
DB_USERNAME=root
DB_PASSWORD=your-password

# Redis (Using common-docker Redis)
REDIS_HOST=common-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h

# Frontend
VITE_API_URL=http://localhost:8081/api
