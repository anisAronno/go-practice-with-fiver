APP_NAME=GoFiver
APP_ENV=development
APP_DEBUG=true
APP_PORT=8080

DB_HOST=common-mysql
DB_PORT=3306
DB_DATABASE=gofiver
DB_USERNAME=root
DB_PASSWORD=your-password

# Database Connection Pool Settings (for high-performance with large datasets)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m

REDIS_HOST=common-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis Connection Pool Settings
REDIS_POOL_SIZE=100
REDIS_MIN_IDLE_CONN=10

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h

# Cache Configuration (enable for production performance)
CACHE_ENABLED=true
CACHE_LIST_TTL=30s
CACHE_COUNT_TTL=60s
CACHE_DETAIL_TTL=5m
CACHE_DEFAULT_PER_PAGE=20
CACHE_MAX_PER_PAGE=100

BUILD_TARGET=development
NGINX_PORT=8088
VITE_API_URL=/api

# Docker Resource Limits (adjust based on your server capacity)
# For 1GB RAM / 1 CPU server configuration:

# API Service
API_CPU_LIMIT=1.0
API_MEMORY_LIMIT=512M
API_CPU_RESERVATION=0.25
API_MEMORY_RESERVATION=128M

# Frontend Service
FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEMORY_LIMIT=256M
FRONTEND_CPU_RESERVATION=0.1
FRONTEND_MEMORY_RESERVATION=64M

# Nginx
NGINX_CPU_LIMIT=0.25
NGINX_MEMORY_LIMIT=64M
NGINX_CPU_RESERVATION=0.05
NGINX_MEMORY_RESERVATION=32M
